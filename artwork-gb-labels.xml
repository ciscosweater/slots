<?xml version="1.0" encoding="UTF-8"?>
<!-- GB / GBC cart labels for slots. The paper on a real cart is 42:37; 192x169 is that
     ratio at the exact size the fork renders. Point Skyscraper at this
     with artworkXml="artwork-gb-labels.xml" for the gb and gbc platforms. -->
<artwork>
  <output type="cover" width="192" height="169">
    <layer resource="cover" width="192" height="169"/>
  </output>
</artwork>
